    {
      "parameters": {
        "jsCode": "// 1) Pega os updates do Telegram\nconst httpItems = $items('Solicitação de HTTP') || [];\nconst updates = httpItems[0]?.json?.result || [];\n\nif (!updates.length) {\n  return [{ json: { \"UPDATE ID\": null, \"RESPONDER\": false, \"TEXTO\": \"\", \"chat_id\": null } }];\n}\n\n// 2) Pega a mensagem mais RECENTE de todas (a última da lista)\nconst ultimaMensagemObj = updates[updates.length - 1];\n\nif (!ultimaMensagemObj || !ultimaMensagemObj.message?.text) {\n  return [{ json: { \"UPDATE ID\": null, \"RESPONDER\": false, \"TEXTO\": \"\", \"chat_id\": null } }];\n}\n\nconst updateId = ultimaMensagemObj.update_id;\nconst textoOriginal = ultimaMensagemObj.message.text;\nconst chatId = ultimaMensagemObj.message.chat.id;\n\n// 3) Normalização (Remover acentos e espaços extras)\nconst textoNormalizado = textoOriginal\n  .trim()\n  .toLowerCase()\n  .normalize(\"NFD\")\n  .replace(/[\\u0300-\\u036f]/g, \"\");\n\n// 4) Verificação de Duplicidade (Lendo da planilha)\nconst sheetItems = $items('Get row(s) in sheet2') || [];\nconst updateIdsPlanilha = sheetItems.map(i => Number(i.json['UPDATE ID']));\nconst jaProcessado = updateIdsPlanilha.includes(updateId);\n\nreturn [{\n  json: {\n    \"UPDATE ID\": updateId,\n    \"RESPONDER\": !jaProcessado, // Só responde se não estiver na planilha\n    \"TEXTO\": textoNormalizado,\n    \"chat_id\": chatId\n  }\n}];"
      },
