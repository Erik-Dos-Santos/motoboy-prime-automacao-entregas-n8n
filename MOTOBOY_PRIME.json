      "parameters": {
        "language": "python",
        "pythonCode": "# 1. Pega TODOS os locais cadastrados que vieram da entrada principal (planilha)\nlocais_cadastrados = [item.json for item in _input.all()]\n\n# 2. Busca o texto enviado pelo nó JavaScript de forma direta e absoluta\ntexto = \"\"\ntry:\n    # A função _() busca o dado exato do nó, ignorando a quantidade de itens da planilha\n    texto = _('Code in JavaScript3').first().json.get('TEXTO', '')\nexcept Exception as e:\n    pass\n\n# Trava de segurança: se o texto vier vazio, avisa no output para facilitar o ajuste\nif not texto:\n    return [{\"json\": {\"erro\": \"Texto do nó 'Code in JavaScript3' não encontrado ou vazio.\"}}]\n\n# Separa Origem e Destino usando o '=>' ou '>'\nseparador = \"=>\" if \"=>\" in texto else (\">\" if \">\" in texto else None)\n\nif separador:\n    partes = texto.split(separador)\n    chave_origem = partes[0].strip().lower()\n    chave_destino = partes[1].strip().lower()\nelse:\n    chave_origem = texto.strip().lower()\n    chave_destino = \"\"\n\n# Função para buscar e tratar as coordenadas da planilha\ndef buscar_coordenadas(chave):\n    if not chave:\n        return 0.0, 0.0, \"\"\n        \n    for loc in locais_cadastrados:\n        nome_local = str(loc.get('LOCAL', '')).strip().lower()\n        \n        if nome_local == chave:\n            # Pega as coordenadas (garantindo compatibilidade com os nomes das colunas da imagem)\n            raw_lat = loc.get('CORDENADAS 2', loc.get('LATITUDE', 0))\n            raw_lon = loc.get('CORDENADAS 1', loc.get('LONGITUDE', 0))\n            \n            # Tratamento de string (remove aspas, espaços e converte vírgula para ponto)\n            lat_str = str(raw_lat).replace(\"'\", \"\").replace(\",\", \".\").strip()\n            lon_str = str(raw_lon).replace(\"'\", \"\").replace(\",\", \".\").strip()\n            \n            try:\n                return float(lat_str), float(lon_str), loc.get('ENDEREÇO', chave)\n            except ValueError:\n                return 0.0, 0.0, chave\n                \n    return 0.0, 0.0, chave\n\nlat_orig, lon_orig, end_orig = buscar_coordenadas(chave_origem)\nlat_dest, lon_dest, end_dest = buscar_coordenadas(chave_destino)\n\n# 3. Estruturação do JSON final compatível com o Google Routes API\npayload = {\n    \"origem_chave\": chave_origem,\n    \"origem_endereco\": end_orig,\n    \"destino_chave\": chave_destino,\n    \"destino_endereco\": end_dest,\n    \"coordenadas_origem\": {\n        \"latitude\": lat_orig,\n        \"longitude\": lon_orig\n    },\n    \"coordenadas_destino\": {\n        \"latitude\": lat_dest,\n        \"longitude\": lon_dest\n    },\n    \"origin\": {\n        \"location\": {\n            \"latLng\": {\n                \"latitude\": lat_orig,\n                \"longitude\": lon_orig\n            }\n        }\n    },\n    \"destination\": {\n        \"location\": {\n            \"latLng\": {\n                \"latitude\": lat_dest,\n                \"longitude\": lon_dest\n            }\n        }\n    },\n    \"travelMode\": \"TWO_WHEELER\",\n    \"routingPreference\": \"TRAFFIC_UNAWARE\"\n}\n\nreturn [{\"json\": payload}]"
      },
