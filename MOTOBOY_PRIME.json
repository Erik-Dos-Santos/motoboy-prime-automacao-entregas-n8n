      "parameters": {
        "jsCode": "// 1) Pega os dados mais recentes que vieram da leitura da planilha (Get row(s) in sheet1)\nconst sheetItems = $items('Get row(s) in sheet1') || [];\nconst totalCorridas = sheetItems.length; \n\n// 2) Calcula o valor total acumulado financeiro\nlet valorTotalAcumulado = 0;\nsheetItems.forEach(item => {\n  let valorRaw = item.json['TOTAL']; \n  \n  if (valorRaw !== undefined && valorRaw !== null) {\n    // Se já for um número puro (ex: 113.69), usamos diretamente\n    if (typeof valorRaw === 'number') {\n      valorTotalAcumulado += valorRaw;\n    } else {\n      let valorStr = String(valorRaw).trim();\n      \n      // Remove o símbolo de R$ e espaços invisíveis\n      valorStr = valorStr.replace('R$', '').replace(/\\s/g, '');\n      \n      // LÓGICA DE CORREÇÃO DE PONTO/VÍRGULA:\n      if (valorStr.includes(',') && valorStr.includes('.')) {\n        valorStr = valorStr.replace(/\\./g, '').replace(',', '.');\n      } \n      else if (valorStr.includes(',')) {\n        valorStr = valorStr.replace(',', '.');\n      }\n      else if (valorStr.includes('.') && valorStr.split('.')[1].length > 2) {\n        valorStr = valorStr.replace(/\\./g, '');\n      }\n\n      let valorNum = parseFloat(valorStr);\n      \n      if (!isNaN(valorNum)) {\n        valorTotalAcumulado += valorNum;\n      }\n    }\n  }\n});\n\n// Formata o valor final para o padrão de exibição\nconst valorTotalFormatado = valorTotalAcumulado.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n\n// 3) Resgata o chat_id de forma segura direto do nó If2 (mesmo método usado no Telegram)\nlet chatId = null;\ntry {\n    chatId = $('If2').first().json.chat_id;\n} catch (error) {\n    // Caso o If2 falhe, tenta buscar do Code in JavaScript3 como plano B\n    try {\n        chatId = $('Code in JavaScript3').first().json.chat_id;\n    } catch (error2) {\n        chatId = null;\n    }\n}\n\nreturn [{\n  json: {\n    \"chat_id\": chatId,\n    \"TOTAL_CORRIDAS\": totalCorridas,\n    \"VALOR_TOTAL_ACUMULADO\": valorTotalFormatado\n  }\n}];"
      },
