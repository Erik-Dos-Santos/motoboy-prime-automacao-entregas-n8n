    {
      "parameters": {
        "language": "python",
        "pythonCode": "# Pega a resposta do nó anterior (HTTP Request)\nitems = _input.all()\nif not items or \"routes\" not in items[0].json:\n    return [{\"json\": {\"erro\": \"Rota não encontrada pelo Google.\"}}]\n\nresponse = items[0].json\nroutes = response.get(\"routes\", [])\n\n# Lógica para encontrar a rota com a menor distância entre todas as retornadas\n# Isso evita que você pegue a de 28km se a de 21km estiver na lista\nmenor_rota = min(routes, key=lambda x: x.get(\"distanceMeters\", float('inf')))\n\nmetros = menor_rota.get(\"distanceMeters\", 0)\ndistancia_km = metros / 1000\nvalor_por_km = 1.50\nvalor_total = distancia_km * valor_por_km\n\n# Formatação brasileira para moeda e km\ndistancia_str = \"{:,.2f}\".format(distancia_km).replace(\".\", \",\")\nvalor_str = \"{:,.2f}\".format(valor_total).replace(\".\", \",\")\n\nreturn [{\n    \"distancia_km_num\": distancia_km,\n    \"distancia_km\": distancia_str,\n    \"valor\": valor_str,\n    \"metros_reais\": metros,\n    \"rota_escolhida\": \"Mais curta detectada\"\n}]"
